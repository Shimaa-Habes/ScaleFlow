          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Enterprise Analytics Engine v2\",\n  \"description\": \"Updated scope with real-time analytics.\",\n  \"progress\": 25,\n  \"isAtRisk\": false,\n  \"status\": 2,\n  \"priority\": 4,\n  \"budget\": 65000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
