{
  "info": {
    "_postman_id": "7f8b9e12-3456-4abc-9def-0123456789ab",
    "name": "ScaleFlow REST API",
    "description": "Postman Collection for testing and integrating with ScaleFlow Enterprise API. Features automatic JWT token handling on login/registration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "bearerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
